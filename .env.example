# CodeSentry Environment Variables

# Hugging Face API Token
# Get your token from: https://huggingface.co/settings/tokens
HF_TOKEN=your_huggingface_token_here

# Key for whichever other provider you use (see api_key_env in config.yaml)
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GROQ_API_KEY=

# Provider-agnostic fallback, used when the provider's own variable is unset
# CODESENTRY_LLM_API_KEY=

# For `codesentry-pr` (needs pull-requests: write, contents: read)
# GITHUB_TOKEN=
